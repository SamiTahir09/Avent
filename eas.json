{
  "cli": {
    "version": ">= 20.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_BILLING_BYPASS": "false",
        "EXPO_PUBLIC_FORCE_TELEMETRY_IN_DEV": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_BILLING_BYPASS": "false",
        "EXPO_PUBLIC_FORCE_TELEMETRY_IN_DEV": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
