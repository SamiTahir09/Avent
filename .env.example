# Copy this file to .env and fill in your own keys. NEVER commit real keys here
# — this file is tracked by git, .env is not.
#
# Where each key comes from:
#   Firebase    https://console.firebase.google.com → Project Settings → Your apps → Web app
#   Gemini      https://aistudio.google.com/apikey
#   Google Maps https://console.cloud.google.com → APIs & Services → Credentials
#               Enable: Places API, Geocoding API, Maps SDK for Android/iOS
#               AND enable billing on the project, or every request returns REQUEST_DENIED.
#   Unsplash    https://unsplash.com/oauth/applications
#   Weather     https://www.weatherapi.com/my/
#
# Verify everything at once:  npm run test:keys
#
# ─── This file only covers LOCAL dev ─────────────────────────────────────────
# .env is gitignored and EAS Build uploads the project from git, so .env never
# reaches the build server. Filling this in makes `npx expo start` work — it
# does nothing for an APK/AAB. After changing a key, push it to EAS too:
#
#   npm run eas:env           # dry run — shows what would be pushed
#   npm run eas:env:push      # push to the preview + production environments
#   npm run check:build-env   # confirm no key is missing before you build
#
# Skipping that step is what causes "Missing EXPO_PUBLIC_WEATHERAPI_KEY" in a
# standalone build while everything works fine in Expo Go.

# ─── Firebase (auth + the server-verified entitlement doc only) ──────────────
# Trips and every other local record live in SQLite, not Firestore.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# G-XXXXXXXXXX — also used as the GA4 measurement id by the analytics fallback.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Google Drive backup (PREMIUM feature) ───────────────────────────────────
# OAuth *client IDs* — not API keys, and there is no client secret for a mobile
# app. Create them at https://console.cloud.google.com → APIs & Services →
# Credentials → Create credentials → OAuth client ID, in the SAME project as your
# Firebase app, and enable the Google Drive API on that project.
#
#   Android: application type "Android", package name com.Tripplanner.company,
#            plus the SHA-1 of the keystore that signs the build
#            (`eas credentials` → Android → show SHA-1).
#   iOS:     application type "iOS", bundle identifier of the iOS app.
#
# Leave both blank and the Backup screen simply reports that backup isn't set up
# in this build — nothing else breaks.
#
# ALSO REQUIRED, and the two things that actually break this feature:
#   1. On the Android client, Advanced Settings → Enable Custom URI scheme.
#      Google turned this off by default for Android clients in Oct 2023; with
#      it off every attempt dies on the "Access blocked" page.
#   2. Add the app package name (com.Tripplanner.company) to app.json's
#      "scheme" array. Android calls back on the package-name scheme -- the
#      reversed client id is the iOS convention only.
# See BACKUP_AND_AUTH_SETUP.md.
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=

# Stamped onto the backup file's metadata so a restore can tell which build wrote
# it. Cosmetic — defaults to 1.0.0.
EXPO_PUBLIC_APP_VERSION=1.0.0

# ─── Gemini AI (trip generation) ─────────────────────────────────────────────
EXPO_PUBLIC_GEMINI_API_KEY=

# ─── Google Maps / Places ────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAP_KEY=
# Optional second key, if you split Places/Photos onto its own restricted key.
EXPO_PUBLIC_GOOGLE_API_KEY=

# ─── Unsplash (trip + location photos) ───────────────────────────────────────
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=

# ─── WeatherAPI.com ──────────────────────────────────────────────────────────
EXPO_PUBLIC_WEATHERAPI_KEY=

# ─── Telemetry ───────────────────────────────────────────────────────────────
# GA4 Measurement Protocol secret. Only needed for the Expo Go / no-native-build
# analytics path: GA4 Admin → Data Streams → your stream → Measurement Protocol
# API secrets → Create. Not needed once @react-native-firebase/analytics is
# installed and you're running a dev/EAS build.
EXPO_PUBLIC_GA4_API_SECRET=

# Analytics and Crashlytics stay silent in __DEV__ so debugging doesn't pollute
# production dashboards. Set this to true to test the Diagnostics screen's
# "Send test event" / "Send test crash" buttons through the Metro dev server,
# then set it back to false.
EXPO_PUBLIC_FORCE_TELEMETRY_IN_DEV=false

# ─── Billing bypass — TESTING ONLY ───────────────────────────────────────────
# true  = tapping any plan grants premium INSTANTLY. No Google Play sheet, no
#         purchase token, no server verification. Persisted in SQLite so it
#         survives a restart. A visible "TEST MODE" banner appears on the
#         paywall and a warning is logged on every launch.
# false = the real expo-iap purchase + verifyPurchase Cloud Function path.
#
# MUST be false for a production build — otherwise every user gets premium free.
EXPO_PUBLIC_BILLING_BYPASS=false
