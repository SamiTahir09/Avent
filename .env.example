# Copy this file to .env and fill in your API keys.
# Get Firebase keys: https://console.firebase.google.com → Project Settings → Your apps → Web app
# Get Gemini key: https://aistudio.google.com/apikey
# Get Google Maps key: https://console.cloud.google.com → APIs & Services → Credentials
#   Enable: Maps SDK, Places API, Geocoding API

# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Gemini AI (trip generation)
EXPO_PUBLIC_GEMINI_API_KEY=

# Google Maps / Places
EXPO_PUBLIC_GOOGLE_MAP_KEY=
# Public API key used by the app (Places, Photos). Set this to your key for Expo frontend usage.
EXPO_PUBLIC_GOOGLE_API_KEY=AIzaSyC4SlElR8DpWWBqeTUNX2MlV2Rj3BvqYns

# Weather API (either provider)
# WeatherAPI.com key (preferred)
EXPO_PUBLIC_WEATHERAPI_KEY=51234ee030c68f86ab0e2969aea61e9b
# OpenWeatherMap OneCall API key (fallback)
EXPO_PUBLIC_OPENWEATHER_KEY=
