rules_version = '2';

// IMPORTANT: this file is the first versioned copy of this project's Firestore
// rules. Before running `firebase deploy --only firestore:rules` for the first
// time, diff this against whatever is currently live in the Firebase console
// (Firestore Database → Rules) so this deploy doesn't silently loosen or
// tighten access for the existing `UserTrips` collection.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a confirmed email address.
    //
    // The client keeps unverified accounts on (auth)/verify-email, but that is
    // only a UI gate — a modified build or a plain REST call with a valid ID
    // token would sail past it. This is the enforcement: `email_verified` is a
    // claim Firebase mints into the token, so a throwaway address can hold an
    // Auth row and still touch no data at all.
    //
    // Caveat that matters when debugging: this reads the *token*, which is
    // cached for up to an hour. A user who has just clicked the link still
    // carries a token saying false until it is refreshed, which is why the app
    // forces getIdToken(true) before letting them in — see
    // services/auth/emailGate.ts.
    function isVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    // Premium/entitlement + free-trip-usage record for each account.
    // Every field here (including freeTripsUsed) is written exclusively by
    // Cloud Functions via the Admin SDK, which bypasses these rules entirely —
    // clients can only ever read their own doc. This is what makes the free
    // trip counter and the `premium` flag tamper-proof against a client that
    // tries to write directly to Firestore.
    match /Users/{userId} {
      allow get: if isVerified() && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Trip records, keyed by a generated docId, scoped to the owning user's
    // email (matches the existing query/write pattern in
    // app/(tabs)/mytrip.tsx and app/generate-trip.tsx).
    match /UserTrips/{tripId} {
      allow read: if isVerified()
        && request.auth.token.email == resource.data.userEmail;
      allow create: if isVerified()
        && request.auth.token.email == request.resource.data.userEmail;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
