rules_version = '2';

// IMPORTANT: this file is the first versioned copy of this project's Firestore
// rules. Before running `firebase deploy --only firestore:rules` for the first
// time, diff this against whatever is currently live in the Firebase console
// (Firestore Database → Rules) so this deploy doesn't silently loosen or
// tighten access for the existing `UserTrips` collection.
service cloud.firestore {
  match /databases/{database}/documents {

    // Premium/entitlement + free-trip-usage record for each account.
    // Every field here (including freeTripsUsed) is written exclusively by
    // Cloud Functions via the Admin SDK, which bypasses these rules entirely —
    // clients can only ever read their own doc. This is what makes the free
    // trip counter and the `premium` flag tamper-proof against a client that
    // tries to write directly to Firestore.
    match /Users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Trip records, keyed by a generated docId, scoped to the owning user's
    // email (matches the existing query/write pattern in
    // app/(tabs)/mytrip.tsx and app/generate-trip.tsx).
    match /UserTrips/{tripId} {
      allow read: if request.auth != null
        && request.auth.token.email == resource.data.userEmail;
      allow create: if request.auth != null
        && request.auth.token.email == request.resource.data.userEmail;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
