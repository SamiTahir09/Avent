# Set to true to let Analytics/Crashlytics report while running through the
# Metro dev server (normally disabled in __DEV__). Useful for testing the
# "Send Test Crash" button in Profile without a full standalone/EAS build —
# remove/set back to false afterward.
EXPO_PUBLIC_FORCE_TELEMETRY_IN_DEV=true





# ─── Billing bypass — TESTING ONLY ───────────────────────────────────────────
# Tapping any premium plan grants premium instantly: no Play Store sheet, no
# purchase token, no server verification. Persisted in SQLite so it survives an
# app restart. Reset via Profile → Diagnostics → "Reset to free tier".
#
# SET THIS TO false BEFORE ANY PRODUCTION BUILD — otherwise every user gets
# premium for free.
EXPO_PUBLIC_BILLING_BYPASS=true

# --- Google Drive backup (OAuth client ids) ------------------------------
# Android client id from Google Cloud Console. Two console settings on this
# client are what make or break the flow: "Enable Custom URI scheme" under
# Advanced Settings (off by default since Oct 2023 -- Google's Access blocked
# page is what you get without it), and a SHA-1 that matches the signing key
# of the build. The redirect scheme is the app package name, NOT the reversed
# client id, and must be listed in app.json. See BACKUP_AND_AUTH_SETUP.md.
EXPO_PUBLIC_GOOGLE_OAUTH_ANDROID_CLIENT_ID=385181211292-rh7lknd3f7enj7mtdekkvkim4pv2bsjg.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=
